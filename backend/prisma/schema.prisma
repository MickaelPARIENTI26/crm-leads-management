generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TELEPRO
}

enum LeadStatus {
  NRP
  A_RAPPELE
  RDV
  ANNULE
}

enum LeadType {
  PV
  ITE
  PAC
}

enum AppointmentStatus {
  ANNULE
  PAS_SIGNE
  SIGNE
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  nom          String?
  role         UserRole
  createdAt    DateTime      @default(now())
  leads        Lead[]
  appointments Appointment[]
}

model Lead {
  id               String        @id @default(uuid())
  dateLead         DateTime
  systemeChauffage String?
  type             LeadType
  codePostal       String
  prenom           String
  nom              String
  email            String
  telephone        String
  status           LeadStatus?
  commentaire      String?
  assignedToId     String?
  assignedTo       User?         @relation(fields: [assignedToId], references: [id])
  createdAt        DateTime      @default(now())
  appointments     Appointment[]
}

model Appointment {
  id          String             @id @default(uuid())
  dateRdv     DateTime
  heureRdv    String
  adresse     String
  nom         String
  prenom      String
  telephone   String
  codePostal  String
  status      AppointmentStatus?
  leadId      String?
  lead        Lead?              @relation(fields: [leadId], references: [id])
  agentId     String
  agent       User               @relation(fields: [agentId], references: [id])
  createdAt   DateTime           @default(now())
}